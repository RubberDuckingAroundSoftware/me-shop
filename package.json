{
  "name": "me-shop",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:agents": "cd agents && uvicorn main:app --reload --port 8000",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:agents\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "rm -f db/meshop.db && tsx db/seed.ts",
    "auth:reset-password": "tsx scripts/reset-password.ts",
    "agents:install": "cd agents && pip install -e '.[dev]' --break-system-packages"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "jose": "^5.10.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.0",
    "next": "^14.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
